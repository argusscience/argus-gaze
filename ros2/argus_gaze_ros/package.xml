<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>argus_gaze_ros</name>
  <version>0.3.0</version>
  <description>ROS 2 node that publishes live gaze from an ETVision eye tracker with ET3Space, in the world frame.</description>
  <maintainer email="info@argusscience.com">Argus Science</maintainer>
  <license>Apache-2.0</license>
  <url type="website">https://argusscience.com</url>
  <url type="repository">https://github.com/argusscience/argus-gaze</url>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>argus_gaze_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
